@startuml
title حالات استخدام دور العضو - LeadScope AI
left to right direction

actor "عضو" as Member

rectangle "LeadScope AI" {
  usecase "مصادقة واستخدام مساحة العمل" as UC_Auth
  usecase "عرض لوحة التحكم\n(INFERRED من route /app)" as UC_Dashboard
  usecase "عرض وظائف البحث السابقة" as UC_SearchView
  usecase "استعراض وتصفية العملاء المحتملين" as UC_Leads
  usecase "تحديث حالة العميل المحتمل" as UC_Status
  usecase "تعيين العميل المحتمل" as UC_Assign
  usecase "إضافة ملاحظة" as UC_Note
  usecase "تشغيل تحليل الذكاء الاصطناعي" as UC_AI
  usecase "استخدام مساعد المبيعات" as UC_Assistant
  usecase "إنشاء وتعديل وإرسال مسودات التواصل" as UC_Outreach
  usecase "تصدير العملاء المحتملين" as UC_Export
  usecase "عرض الفريق" as UC_TeamView
  usecase "عرض الفوترة والاستخدام والفواتير" as UC_BillingView
}

Member --> UC_Auth
Member --> UC_Dashboard
Member --> UC_SearchView
Member --> UC_Leads
Member --> UC_Status
Member --> UC_Assign
Member --> UC_Note
Member --> UC_AI
Member --> UC_Assistant
Member --> UC_Outreach
Member --> UC_Export
Member --> UC_TeamView
Member --> UC_BillingView
@enduml
