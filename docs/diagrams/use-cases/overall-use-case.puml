@startuml
title مخطط حالات الاستخدام العام - LeadScope AI
left to right direction

actor "مالك الحساب" as AccountOwner
actor "مسؤول" as Admin
actor "مدير" as Manager
actor "عضو" as Member

rectangle "LeadScope AI" {
  usecase "عرض الصفحة العامة" as UC_PublicHome
  usecase "إنشاء حساب مساحة عمل" as UC_Signup
  usecase "تسجيل الدخول" as UC_Login
  usecase "تسجيل الخروج" as UC_Logout
  usecase "عرض لوحة التحكم\n(INFERRED من صفحة dashboard)" as UC_Dashboard
  usecase "تشغيل اكتشاف العملاء المحتملين" as UC_Search
  usecase "متابعة وظائف البحث وتدفق التقدم" as UC_SearchProgress
  usecase "استعراض وتصفية العملاء المحتملين" as UC_Leads
  usecase "إدارة حالة وتعيين وملاحظات العميل المحتمل" as UC_LeadManage
  usecase "تحليل عميل محتمل بالذكاء الاصطناعي" as UC_AIAnalyze
  usecase "محادثة مع مساعد المبيعات" as UC_Assistant
  usecase "إنشاء وتعديل وإرسال مسودة تواصل" as UC_Outreach
  usecase "تصدير العملاء المحتملين" as UC_Export
  usecase "عرض الفريق" as UC_TeamView
  usecase "إدارة الفريق" as UC_TeamManage
  usecase "عرض الفوترة والاستخدام والفواتير" as UC_BillingView
  usecase "إدارة الاشتراك وحالة الفواتير" as UC_BillingManage
  usecase "إدارة الإعدادات والتسجيل والتزويد" as UC_AdminOps
  usecase "عرض سجلات التدقيق" as UC_Audit
}

AccountOwner --> UC_PublicHome
Admin --> UC_PublicHome
Manager --> UC_PublicHome
Member --> UC_PublicHome
AccountOwner --> UC_Login
Admin --> UC_Login
Manager --> UC_Login
Member --> UC_Login

AccountOwner --> UC_Signup

