APP_NAME=LeadScope AI API
APP_ENV=development
API_V1_PREFIX=/api/v1

# Start MariaDB first: docker compose -f ../../infra/docker-compose.yml up -d
DATABASE_URL=sqlite:///./prospectiq-local.db

# Local development secret (replace for shared/staging/prod environments).
JWT_SECRET=local-dev-jwt-secret-please-override-before-sharing-2026
JWT_EXPIRE_MINUTES=120
WEB_ORIGIN=http://localhost:5173
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SQL_ECHO=false
LOG_LEVEL=INFO
ENABLE_DB_HEALTHCHECK=true
ENABLE_REQUEST_LOGGING=true
ENABLE_API_DOCS=false
DEFAULT_ADMIN_EMAIL=admin@prospectiq.dev
DEFAULT_ADMIN_PASSWORD=local-dev-admin-password-rotate-before-sharing
DEFAULT_ADMIN_NAME=LeadScope AI Admin
DEFAULT_WORKSPACE_PUBLIC_ID=ws_default
DEFAULT_WORKSPACE_NAME=Default Workspace

# Default profile here is explicit local demo mode.
# For real provider calls, use apps/api/.env.local-live.example instead.
# Discovery runtime:
# - live: requires real SERPAPI_API_KEY
# - demo: explicit demo mode for local verification without external calls
# - stub: deterministic test-only mode
# - blocked: disables discovery endpoints/workers
SERPAPI_RUNTIME_MODE=demo
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search.json
# Tavily is an optional SDK-backed engine for Search, selective Extract, and
# opt-in Research. Default tests use stubs. Live Tavily tests require
# TAVILY_LIVE_E2E=1 and are not enabled in CI by default.
# - live: use real Tavily API (requires TAVILY_API_KEY)
# - stub: deterministic test-only mode
TAVILY_RUNTIME_MODE=stub
TAVILY_API_KEY=
TAVILY_LIVE_E2E=0
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic
TAVILY_RATE_LIMIT_RPM=60
TAVILY_LIVE_MAX_CALLS=3
# Apify is a deep-extraction/crawling layer invoked only through a fixed
# allowlist of Actor keys (see docs/PROVIDERS.md). No LLM or caller can pass
# an arbitrary Actor ID.
# - live: use real Apify API (requires APIFY_API_TOKEN)
# - stub: deterministic test-only mode
APIFY_RUNTIME_MODE=stub
APIFY_API_TOKEN=
APIFY_ACTOR_COMPANY_WEBSITE_CRAWLER=apify/website-content-crawler
APIFY_ACTOR_BUSINESS_DIRECTORY_CRAWLER=
APIFY_ACTOR_SOCIAL_PUBLIC_PROFILE_CRAWLER=
APIFY_ACTOR_REVIEWS_CRAWLER=
APIFY_MAX_DATASET_ITEMS=20
APIFY_TIMEOUT_SECONDS=90
DISCOVERY_KILL_SWITCH=false
# single_path | multi_query_single_engine | multi_engine_multi_query
DISCOVERY_MODE=multi_engine_multi_query
# Optional compatibility switch: when false, multi_engine_multi_query downgrades to multi_query_single_engine.
DISCOVERY_MULTI_ENGINE_ENABLED=true
# Canonical engine list variable (DISCOVERY_ENABLED_ENGINES also supported for compatibility)
# Add "tavily_web" here to opt into Tavily-backed discovery and website validation.
DISCOVERY_ENGINE_LIST=google_maps_search,google_maps_place,google_web
DISCOVERY_MAX_CONCURRENCY=4
DISCOVERY_MAX_CALLS_PER_JOB=24
DISCOVERY_MAX_CANDIDATES_AFTER_MERGE=100
DISCOVERY_MAX_ENRICHMENTS_PER_JOB=20
DISCOVERY_GLOBAL_JOB_DEADLINE_SECONDS=300
DISCOVERY_BILINGUAL_EXPANSION_ENABLED=true
DISCOVERY_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
DISCOVERY_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
# Multi-source enrichers run after discovery (comma-separated; empty disables all).
# Available: google_maps_reviews, yelp, google_news, linkedin. Requires a live SERPAPI_API_KEY.
ENRICHERS=google_maps_reviews,yelp,google_news,linkedin

# AI runtime:
# - ollama: primary local runtime, optional OpenAI fallback if key exists
# - openai: primary OpenAI runtime, optional Ollama fallback if configured
# - auto: prefer Ollama when reachable, otherwise OpenAI
# - stub: deterministic demo responses
AI_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Agent runtime ---
# auto | openai | stub | blocked
AGENT_RUNTIME_MODE=auto
AGENT_STREAM_HEARTBEAT_SECONDS=15
AGENT_STREAM_MAX_SECONDS=300
AGENT_MAX_RAG_QUERIES=8
# External sending (email / WhatsApp / LinkedIn). Leave false unless an
# audited delivery transport has been wired and reviewed: while false the
# send tools are invisible to the model and refused by the executor.
EXTERNAL_SEND_ENABLED=false

# --- AI runtime cost control -------------------------------------------
# Provider rates, as a JSON list. Deliberately EMPTY by default: with no
# rates configured every cost is recorded as unknown (null) rather than
# guessed, because a stale hardcoded price is worse than an honest gap.
# [{"provider":"openai","model":"gpt-4.1-mini","input_rate_micro_per_1k":400,
#   "output_rate_micro_per_1k":1600,"effective_from":"2026-01-01"},
#  {"provider":"tavily","model":"search_web_tavily","unit_rate_micro":8000}]
PROVIDER_PRICING_JSON=
# Deterministic model routing per task, as JSON. Empty means every task uses
# OPENAI_MODEL. A tool_selection candidate with "supports_tools": false is
# never used for tool selection, even as a fallback.
# {"tool_selection":[{"provider":"openai","model":"gpt-4.1","supports_tools":true}]}
AGENT_MODEL_ROUTING_JSON=
# Per-run cost ceiling in micro-USD. 0 disables it, which is correct while
# PROVIDER_PRICING_JSON is empty: a ceiling over unknown costs is not a
# ceiling.
AGENT_MAX_COST_MICRO_USD=0
AGENT_MAX_MODEL_CALLS=14
AGENT_MAX_INPUT_TOKENS=200000
AGENT_MAX_OUTPUT_TOKENS=40000
AGENT_MAX_MODEL_FALLBACKS=1

# --- Sales Knowledge RAG ---
# auto | openai | local  (local = deterministic offline hashing embedder)
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_FALLBACK_ENABLED=true
KNOWLEDGE_SEARCH_DEFAULT_LIMIT=5
KNOWLEDGE_SEARCH_CANDIDATE_LIMIT=400
KNOWLEDGE_HYBRID_VECTOR_WEIGHT=0.7
KNOWLEDGE_MIN_SIMILARITY=0.05
KNOWLEDGE_MIN_VECTOR_ONLY_SIMILARITY=0.35
