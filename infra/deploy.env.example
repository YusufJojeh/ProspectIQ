COMPOSE_PROJECT_NAME=leadscope-ai

API_IMAGE=ghcr.io/yusufjojeh/prospectiq-api:latest
WEB_IMAGE=ghcr.io/yusufjojeh/prospectiq-web:latest

MARIADB_DATABASE=prospectiq
MARIADB_USER=prospectiq
MARIADB_PASSWORD=replace-me
MARIADB_ROOT_PASSWORD=replace-root-me

APP_NAME="LeadScope AI API"
APP_ENV=production
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+pymysql://prospectiq:replace-me@db:3306/prospectiq
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=120
WEB_ORIGIN=https://leadscope.example.com
WEB_ORIGINS=https://leadscope.example.com
SQL_ECHO=false
LOG_LEVEL=INFO
ENABLE_DB_HEALTHCHECK=true
ENABLE_REQUEST_LOGGING=true
ENABLE_API_DOCS=false
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-admin-password
DEFAULT_ADMIN_NAME="LeadScope AI Admin"
DEFAULT_WORKSPACE_PUBLIC_ID=ws_default
DEFAULT_WORKSPACE_NAME="Default Workspace"

SERPAPI_RUNTIME_MODE=live
SERPAPI_API_KEY=replace-with-serpapi-key
SERPAPI_BASE_URL=https://serpapi.com/search.json
# Tavily is optional (secondary website/visibility validation engine).
# Runtime auto-resolves to "live" once TAVILY_API_KEY is set to a real key, or
# "blocked" (safely skipped) if left blank/placeholder — no need to also set
# TAVILY_RUNTIME_MODE unless you want to force a specific mode.
# Add "tavily_web" to DISCOVERY_ENGINE_LIST once a real key is configured.
TAVILY_API_KEY=replace-with-tavily-key
TAVILY_BASE_URL=https://api.tavily.com/search
DISCOVERY_KILL_SWITCH=false
DISCOVERY_MODE=multi_engine_multi_query
DISCOVERY_MULTI_ENGINE_ENABLED=true
DISCOVERY_ENGINE_LIST=google_maps_search,google_maps_place,google_web
DISCOVERY_MAX_CONCURRENCY=4
DISCOVERY_MAX_CALLS_PER_JOB=24
DISCOVERY_MAX_CANDIDATES_AFTER_MERGE=100
DISCOVERY_MAX_ENRICHMENTS_PER_JOB=20
DISCOVERY_GLOBAL_JOB_DEADLINE_SECONDS=300
DISCOVERY_BILINGUAL_EXPANSION_ENABLED=true
DISCOVERY_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
DISCOVERY_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

AI_PROVIDER=ollama
OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

API_PORT=8000
API_WEB_CONCURRENCY=2
RUN_MIGRATIONS=1

WEB_PORT=80
API_UPSTREAM=http://api:8000
WEB_PUBLIC_API_BASE_URL=
